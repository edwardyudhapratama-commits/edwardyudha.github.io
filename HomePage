</div>

<div class="footer-right">

<h3>Readers’ Notes</h3>

<form action="feedback.php" method="POST">

<input type="text" name="signature" placeholder="Signature" required>

<textarea name="message" placeholder="Write Your Letter..." required></textarea>

<input type="submit" value="Send">

</form>

<p id="notif" style="color:#752a39;"></p>

</div>
</div>
</footer>

<script>

const params = new URLSearchParams(window.location.search);

if(params.get('status')==='success'){
document.getElementById('notif').textContent="We have most joyfully received your note.💗";
}

const books = [
{ title:"To Sir Phillip, With Love", link:"koleksi buku/book1.html" },
];

const input = document.getElementById('search');
const suggestions = document.getElementById('suggestions');

input.addEventListener('input', () => {

const query = input.value.toLowerCase();
suggestions.innerHTML='';

if(!query) return;

const filtered = books.filter(book =>
book.title.toLowerCase().includes(query)
);

filtered.forEach(book => {

const li=document.createElement('li');
li.textContent=book.title;

li.addEventListener('click',()=>{
window.location.href=book.link;
});

suggestions.appendChild(li);

});

});

</script>

